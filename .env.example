# =============================================================================
# zone-scan (@paradoxcomputer/zonescan) example environment configuration
# =============================================================================
#
# Copy this file to ".env" and edit it. zone-scan loads a .env file from the
# current working directory AND from <data>/.env on startup.
#
# Setting a COMPLETE config here means the app is already configured and the
# web setup page (/setup?token=...) becomes OPTIONAL; you only need it if you
# prefer to configure sequencers/L1 through the browser admin UI instead.
#
# There are two runtime modes; pick ONE of the two example blocks below:
#   (A) L1 mode: read settlement data from a Logos L1 node.
#   (B) Local sequencer mode: no L1; read blocks straight from a sequencer's
#                              JSON-RPC (works fully offline against a local
#                              sequencer).
#
# Lines starting with "#" are comments. Uncomment the lines you need.
# =============================================================================
#
# -----------------------------------------------------------------------------
# Transaction decoding (BUILD/INSTALL-time choice, read by the npm launcher)
# -----------------------------------------------------------------------------
# Full per-transaction decoding (tx type / program / shield vs. deshield) is ON by
# default; the prebuilt binaries include it. When there's no prebuilt for your
# platform it's built from source, which is HEAVY (pulls the logos-blockchain +
# risc0 stack) and can fail. Set this to 0 for a fast, light build (block-level
# data + liveness only). A failed decode build falls back to light automatically.
#
#   ZONE_SCAN_DECODE=0


# -----------------------------------------------------------------------------
# (A) L1 MODE
# -----------------------------------------------------------------------------
# Point ZONE_SCAN_L1_NODE_URL at a Logos L1 node. zone-scan watches the L1 for
# settlement data and shows per-sequencer transactions, accounts and liveness.
# Provide at least one sequencer channel so it knows what to track.
#
#   ZONE_SCAN_L1_NODE_URL=http://127.0.0.1:8545
#
# Sequencers: comma-separated entries, each "channel|rpc_url|label|full".
# Only "channel" is required. Adding an rpc_url enables no-L1 reads for that
# entry; "label" is a display name; trailing "full" deep-walks that channel's
# history. In L1 mode you typically just list the channel(s):
#
#   ZONE_SCAN_SEQUENCERS=0xabc123...|||
#
# Optional: route an L1 that is a Tor .onion service through a SOCKS5 proxy
# (e.g. a local Tor daemon). Format host:port.
#
#   ZONE_SCAN_SOCKS5=127.0.0.1:9050
#   ZONE_SCAN_L1_NODE_URL=http://abcdefghijklmnop.onion:8545


# -----------------------------------------------------------------------------
# (B) LOCAL SEQUENCER, NO L1
# -----------------------------------------------------------------------------
# Leave the L1 URL EMPTY (or unset) to run in no-L1 local-sequencer mode, then
# give each sequencer an rpc_url so zone-scan reads blocks directly from the
# sequencer's JSON-RPC. The "full" suffix (4th field) deep-walks history.
#
#   ZONE_SCAN_L1_NODE_URL=
#   ZONE_SCAN_SEQUENCERS=0xabc123...|http://127.0.0.1:3040|local-seq|full


# -----------------------------------------------------------------------------
# Admin / setup token
# -----------------------------------------------------------------------------
# Stable token guarding the setup page and the mutating API (POST /api/config,
# etc.). Supply it via header "X-Setup-Token: <token>" or
# "Authorization: Bearer <token>" or "?token=<token>".
# If unset, the binary generates one and writes <data>/setup-token (mode 0600)
# and prints a "setup: http://127.0.0.1:8088/setup?token=<token>" line.
#
#   ZONE_SCAN_ADMIN_TOKEN=change-me-to-a-long-random-secret


# -----------------------------------------------------------------------------
# Server bind + data directory
# -----------------------------------------------------------------------------
# Host/port the web dashboard binds to (defaults: 127.0.0.1 / 8088).
#
#   ZONE_SCAN_HOST=127.0.0.1
#   ZONE_SCAN_PORT=8088
#
# Data directory (holds config.json, store.redb, setup-token). If unset the
# resolution order is:
#   $ZONE_SCAN_DATA
#   || ($XDG_CONFIG_HOME ? "$XDG_CONFIG_HOME/zone-scan" : "$HOME/.config/zone-scan")
#   (on Windows: %APPDATA%/zone-scan)
#
#   ZONE_SCAN_DATA=/home/youruser/.config/zone-scan
#
# Explicit path to a config.json (overrides the default <data>/config.json).
#
#   ZONE_SCAN_CONFIG=/home/youruser/.config/zone-scan/config.json


# -----------------------------------------------------------------------------
# Indexing / discovery tuning
# -----------------------------------------------------------------------------
# Walk full chain history rather than just the recent tip (1/true to enable).
#
#   ZONE_SCAN_FULL_HISTORY=0
#
# Don't store/index clock-program txs (the clock ticks every block, ~99% of all
# txs); liveness + consistency are unaffected. Shrinks the store dramatically (1/true).
#
#   ZONE_SCAN_SKIP_CLOCK=0
#
# How many slots back to scan when discovering sequencers (integer).
#
#   ZONE_SCAN_DISCOVER_SLOTS=1024
#
# Cap on how many sequencers discovery will return (integer).
#
#   ZONE_SCAN_DISCOVER_LIMIT=64
#
# How often (seconds) to re-scan the L1 for newly-launched sequencers, so they're
# picked up without a restart. Only runs when ZONE_SCAN_DISCOVER_LIMIT is set. Default 1800.
#
#   ZONE_SCAN_DISCOVER_INTERVAL_SECS=1800


# -----------------------------------------------------------------------------
# Other supported environment variables
# -----------------------------------------------------------------------------
# Start the bundled Tor inside the Docker entrypoint (1 to enable).
#
#   ZONE_SCAN_TOR=0
#
# Do not auto-open a browser from the launcher (1 to enable).
#
#   ZONE_SCAN_NO_OPEN=0
#
# Explicit path to the zone-scan binary (skips download/build resolution).
#
#   ZONE_SCAN_BIN=/usr/local/bin/zone-scan
#
# Skip downloading a prebuilt binary in the npm postinstall step (1 to enable;
# falls back to building from source).
#
#   ZONE_SCAN_SKIP_DOWNLOAD=0
