{
  "name": "@paradoxcomputer/zonescan",
  "version": "0.6.1",
  "description": "Transaction explorer for Logos Execution Zone (LEZ) sequencers: a live web dashboard over public on-chain settlement data. Reads from a Logos L1 node, or directly from a local sequencer with no L1. Run `zonescan setup` for a token-gated setup page, or configure headlessly via env/.env.",
  "bin": {
    "zonescan": "bin/zone-scan.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/",
    "logo-nav.png",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "postinstall": "node scripts/install.js",
    "build": "cargo build --release --features decode",
    "build:light": "cargo build --release",
    "start": "node bin/zone-scan.js"
  },
  "keywords": [
    "lez",
    "logos",
    "blockchain",
    "explorer",
    "sequencer",
    "zk",
    "paradox"
  ],
  "engines": {
    "node": ">=16"
  },
  "license": "GPL-3.0-or-later",
  "author": "Paradox Computer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paradoxcomputer/zonescan.git"
  },
  "bugs": {
    "url": "https://github.com/paradoxcomputer/zonescan/issues"
  },
  "homepage": "https://github.com/paradoxcomputer/zonescan#readme",
  "publishConfig": {
    "access": "public"
  }
}
